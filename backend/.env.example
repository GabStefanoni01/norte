PORT=3000

# URL(s) do frontend permitidas pelo CORS, separadas por virgula. Sem isso,
# libera qualquer origem (ok para dev local, mas defina isso em producao).
# Ex: FRONTEND_URL=https://norte.vercel.app
FRONTEND_URL=

# Local (docker-compose up -d):
# DATABASE_URL=postgres://norte:norte@localhost:5432/norte

# Neon (nuvem) — copie a connection string do painel do projeto em
# https://console.neon.tech, garantindo "?sslmode=require" no final:
DATABASE_URL=postgres://usuario:senha@ep-exemplo.neon.tech/norte?sslmode=require

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# IA (mentor no chat, teste de descoberta, plano de evolucao, busca de oportunidades)
# Gratis: gere sua chave em https://aistudio.google.com/apikey (nao pede cartao)
GEMINI_API_KEY=

# E-mail (opcional em dev — sem isso, os códigos aparecem no console do backend)
# IMPORTANTE (Brevo e provedores similares): SMTP_FROM precisa ser um e-mail
# verificado como "sender" no painel do provedor — NÃO o mesmo endereço do
# SMTP_USER (que é só a credencial de login, não pode enviar como remetente).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Norte <no-reply@norte.app>

# E-mail que recebe as mensagens do formulario de contato do site.
# Sem isso, cai no SMTP_FROM.
CONTACT_EMAIL=

# Lembretes por e-mail (incentivo a completar o plano, aviso de renovacao a
# cada ~3 meses). true = roda um agendador interno (todo dia as 9h) dentro
# do proprio processo do backend — so faz sentido se ele rodar continuamente
# (Railway, Docker, servidor tradicional). Em ambiente serverless, deixe
# false e configure um cron externo do provedor chamando
# POST /admin/lembretes/enviar (autenticado como admin) periodicamente.
ENABLE_CRON=false

# Mercado Pago (assinatura Premium)
MP_ACCESS_TOKEN=
