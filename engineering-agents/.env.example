# Copie este arquivo para .env. Nunca versione o .env real.
# Usado pelo Docker Compose para o PostgreSQL local.
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Usado ao rodar a API/migrations diretamente no Node.js com Neon ou outro PostgreSQL.
# Substitua pelo connection string do seu banco. Não compartilhe nem versione credenciais.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
PGSSLMODE=require
DASHBOARD_ORIGIN=http://localhost:8080
CONTROL_API_URL=http://localhost:4310
# Opcional: caminho absoluto do repositório que será analisado. Se omitido, usa a raiz deste clone Norte.
# DISCOVERY_REPO_PATH=C:\Users\SeuUsuario\Documents\norte
# Identidade do repositório de origem exibida no dashboard.
DISCOVERY_REPOSITORY_NAME=Norte
DISCOVERY_REPOSITORY_URL=https://github.com/GabStefanoni01/norte
# Opcional: branch/ref exata para criar links diretos aos arquivos (ex.: develop).
# DISCOVERY_REPOSITORY_REF=develop

# Gere dois segredos aleatórios diferentes, cada um com pelo menos 32 caracteres.
AGENTS_API_TOKEN=replace_with_a_different_random_secret_of_at_least_32_chars
AGENTS_INGEST_TOKEN=replace_with_another_different_random_secret_of_at_least_32_chars
