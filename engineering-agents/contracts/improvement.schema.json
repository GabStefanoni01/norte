{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norte.example/schemas/improvement.schema.json",
  "title": "Engineering Improvement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "category", "status", "priority", "evidence", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "category": { "type": "string", "enum": ["security", "reliability", "performance", "testing", "architecture", "maintainability", "documentation", "accessibility", "other"] },
    "findingType": { "type": "string", "enum": ["potential_defect", "code_smell", "maintenance_signal"] },
    "recommendedAction": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "priorityRationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "type": "string", "enum": ["discovered", "triaged", "queued", "analyzing", "planned", "implementing", "reviewing", "validating", "awaiting_approval", "rejected", "blocked", "failed", "cancelled", "completed"] },
    "priority": { "type": "number", "minimum": 0, "maximum": 100 },
    "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
    "risk": { "type": "integer", "minimum": 1, "maximum": 5 },
    "repositoryName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "repositoryUrl": { "type": "string", "format": "uri", "maxLength": 1000 },
    "repositoryRef": { "type": "string", "minLength": 1, "maxLength": 255 },
    "evidence": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1, "maxLength": 2000 }, "path": { "type": "string", "maxLength": 500 }, "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "format": "uri" } } } },
    "branchName": { "type": "string", "pattern": "^agents/improvement-[A-Za-z0-9._-]+$" },
    "pullRequestUrl": { "type": "string", "format": "uri" },
    "blockedReason": { "type": "string", "maxLength": 2000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}