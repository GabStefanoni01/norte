{
  "name": "norte-engineering-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Independent engineering agents platform",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check shared/branch-policy.js && node --check services/control-api/src/server.js && node --check services/control-api/src/migrate.js && node --check services/discovery-service/src/discover.js && node --check worker/src/worker.js && node --check worker/src/workspace-manager.js && node --check worker/src/workspace-plan.js && node --check worker/src/workspace-create.js",
    "migrate": "npm --prefix services/control-api run migrate",
    "discover": "npm --prefix services/discovery-service run discover",
    "worker:dry-run": "node --env-file=.env worker/src/worker.js",
    "worker:claim-dry-run": "node --env-file=.env worker/src/worker.js --claim-dry-run",
    "worker:workspace-plan": "node --env-file=.env worker/src/workspace-plan.js",
    "worker:workspace-create": "node --env-file=.env worker/src/workspace-create.js",
    "orchestrator:check": "python -m compileall -q orchestrator/app",
    "orchestrator:test": "python -m pytest orchestrator/tests",
    "orchestrator:serve": "cd orchestrator && python -m uvicorn app.api:app --host 127.0.0.1 --port 4320"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
