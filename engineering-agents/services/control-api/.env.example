PORT=4310
DATABASE_URL=postgresql://agents_user:change_me@localhost:5432/norte_agents
# Generate a random secret with at least 32 characters. Never commit real values.
AGENTS_API_TOKEN=replace_with_a_long_random_secret_of_at_least_32_chars
# Exact dashboard origin, e.g. http://localhost:5173. Leave unset to deny browser cross-origin access.
DASHBOARD_ORIGIN=http://localhost:5173
# Set to require only when the database server is configured for TLS.
PGSSLMODE=disable