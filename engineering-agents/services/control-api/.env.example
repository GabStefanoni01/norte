PORT=4310
# Use a connection string for the PostgreSQL instance used by this API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate two different random secrets with at least 32 characters. Never commit real values.
AGENTS_API_TOKEN=replace_with_a_long_random_secret_of_at_least_32_chars
AGENTS_INGEST_TOKEN=replace_with_a_different_random_secret_of_at_least_32_chars
# Must exactly match the browser origin hosting the dashboard.
DASHBOARD_ORIGIN=http://localhost:8080
# Optional discovery metadata; set the ref to the branch being scanned for direct file links.
DISCOVERY_REPOSITORY_NAME=Norte
DISCOVERY_REPOSITORY_URL=https://github.com/GabStefanoni01/norte
# DISCOVERY_REPOSITORY_REF=develop
# Use require for managed PostgreSQL providers such as Neon; disable only for local plain-text PostgreSQL.
PGSSLMODE=require
